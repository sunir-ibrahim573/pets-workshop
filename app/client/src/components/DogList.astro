---
import BorderGlow from './BorderGlow.jsx';

interface Dog {
  id: number;
  name: string;
  breed: string;
}

interface Props {
  dogs: Dog[];
}

const { dogs } = Astro.props;
---

<div>
  <h2 class="text-2xl font-medium mb-6 text-slate-100">Available Dogs</h2>

  {dogs.length === 0 ? (
    <div class="text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700" data-testid="empty-state">
      <p class="text-slate-300">No dogs available at the moment.</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="dog-list">
      {dogs.map((dog) => (
        <a href={`/dog/${dog.id}`} class="group block" data-testid="dog-card">
          <BorderGlow
            client:load
            edgeSensitivity={30}
            glowColor="220 90 65"
            backgroundColor="#0f172a"
            borderRadius={16}
            glowRadius={32}
            glowIntensity={1.0}
            coneSpread={25}
            colors={["#3b82f6", "#a855f7", "#22d3ee"]}
          >
            <div class="p-6">
              <h3 class="text-xl font-semibold text-slate-100 mb-2 group-hover:text-blue-400 transition-colors" data-testid="dog-name">{dog.name}</h3>
              <p class="text-slate-400 mb-4" data-testid="dog-breed">{dog.breed}</p>
              <div class="mt-4 text-sm text-blue-400 font-medium flex items-center">
                <span>View details</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 transform transition-transform duration-300 group-hover:translate-x-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
          </BorderGlow>
        </a>
      ))}
    </div>
  )}
</div>
